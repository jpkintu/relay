# Vite reads this file at dev-server start. The platform-managed original is
# not exported — copy this to .env.local if you need to override the defaults.
#
# The app id your Parse Server runs with. Defaults to 'sandbox-app-id', which
# is what your Back4App workspace used.
# VITE_PARSE_APP_ID=sandbox-app-id
#
# Only used by apps that wired managed Google sign-in.
# VITE_BACK4APP_OAUTH_PROXY_URL=
#
# Demo "preview" mode (sales demos only). Needs RELAY_ENABLE_PREVIEW=true in the
# Cloud Code environment as well. Leave unset in production.
# VITE_ENABLE_PREVIEW=true
