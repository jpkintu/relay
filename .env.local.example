# Copy to .env.local for local overrides, or set these as environment variables
# on the frontend deployment (they are read at BUILD time).
#
# Back4App Parse app (production). Values from the Back4App dashboard →
# App Settings → Security & Keys. These are public client keys.
# VITE_PARSE_SERVER_URL=https://parseapi.back4app.com
# VITE_PARSE_APP_ID=
# VITE_PARSE_JS_KEY=
#
# Leave all three unset for local development against a local Parse Server
# on http://localhost:1337 (app id 'sandbox-app-id', proxied at /parse).
#
# Demo "preview" mode (sales demos only). Needs RELAY_ENABLE_PREVIEW=true in the
# Cloud Code environment as well. Leave unset in production.
# VITE_ENABLE_PREVIEW=true
#
# Only used by apps that wired managed Google sign-in.
# VITE_BACK4APP_OAUTH_PROXY_URL=
